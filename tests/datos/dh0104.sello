fn HasNoEvenDigit(n: Int) -> Bool
  requires (n == n)
  ensures (result == ((n >= 0) and (((n < 10) and ((n % 2) == 1)) or (((n % 2) == 1) and HasNoEvenDigit((n / 10))))))
  effects pure
  example (HasNoEvenDigit(0) == false)
  example (HasNoEvenDigit(1) == true)
{
  ((n >= 0) and (((n < 10) and ((n % 2) == 1)) or (((n % 2) == 1) and HasNoEvenDigit((n / 10)))))
}

fn Insert(x: Int, xs: List[Int]) -> List[Int]
  requires forall i in 0..len(xs): forall j in (i + 1)..len(xs): (xs[i] <= xs[j])
  ensures forall i in 0..len(result): forall j in (i + 1)..len(result): (result[i] <= result[j])
  ensures forall e in result: ((e == x) or contains(xs, e))
  ensures forall e in xs: contains(result, e)
  ensures contains(result, x)
  ensures len(result) == (len(xs) + 1)
  effects pure
  example (Insert(2, []) == [2])
  example (Insert(2, [1, 3]) == [1, 2, 3])
{
  match xs {
    [] => [x]
    [h, ..t] => if x <= h then [x] ++ xs else [h] ++ Insert(x, t)
  }
}

fn Build(xs: List[Int]) -> List[Int]
  requires (len(xs) >= 0)
  ensures forall i in 0..len(result): HasNoEvenDigit(result[i])
  ensures forall i in 0..len(result): forall j in (i + 1)..len(result): (result[i] <= result[j])
  ensures forall e in xs: ((not HasNoEvenDigit(e)) or contains(result, e))
  ensures forall e in result: contains(xs, e)
  effects pure
  example (Build([]) == [])
  example (Build([3, 2, 5]) == [3, 5])
{
  match xs {
    [] => []
    [h, ..t] => if HasNoEvenDigit(h) then Insert(h, Build(t)) else Build(t)
  }
}

fn UniqueDigits(x: List[Int]) -> List[Int]
  requires (len(x) >= 0)
  ensures forall i in 0..len(result): HasNoEvenDigit(result[i])
  ensures forall i in 0..len(result): forall j in (i + 1)..len(result): (result[i] <= result[j])
  ensures forall e in x: ((not HasNoEvenDigit(e)) or contains(result, e))
  ensures forall e in result: contains(x, e)
  effects pure
  example (UniqueDigits([]) == [])
  example (UniqueDigits([2, 3, 4, 5]) == [3, 5])
{
  Build(x)
}
