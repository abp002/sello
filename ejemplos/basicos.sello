# Funciones de referencia. `sello check ejemplos/basicos.sello`

fn factorial(n: Int) -> Int
  requires n >= 0
  ensures result >= 1
  effects pure
  example factorial(0) == 1
  example factorial(5) == 120
{
  if n == 0 then 1 else n * factorial(n - 1)
}

fn div(a: Int, b: Int) -> Int
  requires b != 0
  ensures result * b <= a
  effects pure
  example div(7, 2) == 3
  example div(-7, 2) == -4
{
  a / b
}

fn max_of(xs: List[Int]) -> Int
  requires len(xs) > 0
  ensures contains(xs, result)
  ensures forall x in xs: x <= result
  effects pure
  example max_of([3, 9, 1]) == 9
  example max_of([-3]) == -3
{
  match xs {
    [] => 0
    [h, ..t] => if t == [] then h else if h >= max_of(t) then h else max_of(t)
  }
}

fn nth(xs: List[Int], i: Int) -> Option[Int]
  requires i >= 0
  ensures i < len(xs) or result == None
  ensures i >= len(xs) or result != None
  effects pure
  example nth([4, 5], 1) == Some(5)
  example nth([4, 5], 2) == None
{
  match xs {
    [] => None
    [h, ..t] => if i == 0 then Some(h) else nth(t, i - 1)
  }
}

fn dedupe(xs: List[Int]) -> List[Int]
  requires len(xs) >= 0
  ensures distinct(result)
  ensures forall x in xs: contains(result, x)
  effects pure
  example dedupe([1, 2, 1, 3]) == [2, 1, 3]
  example dedupe([]) == []
{
  match xs {
    [] => []
    [h, ..t] => if contains_in(t, h) then dedupe(t) else [h] ++ dedupe(t)
  }
}

fn contains_in(xs: List[Int], v: Int) -> Bool
  requires len(xs) >= 0
  ensures result == contains(xs, v)
  effects pure
  example contains_in([1, 2], 2) == true
  example contains_in([], 2) == false
{
  match xs {
    [] => false
    [h, ..t] => h == v or contains_in(t, v)
  }
}
