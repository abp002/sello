fn max_of(a: Int, b: Int) -> Int
  requires true
  ensures result >= a and result >= b
  ensures result == a or result == b
  effects pure
  example max_of(1, 2) == 2
  example max_of(5, 5) == 5
  example max_of(-3, -7) == -3
{ if a >= b then a else b }

fn abs_val(x: Int) -> Int
  requires true
  ensures result >= 0
  ensures result == x or result == -x
  effects pure
  example abs_val(-7) == 7
  example abs_val(0) == 0
{ if x < 0 then -x else x }

fn factorial(n: Int) -> Int
  requires n >= 0
  ensures result >= 1
  effects pure
  example factorial(0) == 1
  example factorial(5) == 120
{ if n == 0 then 1 else n * factorial(n - 1) }

fn sum_list(xs: List[Int]) -> Int
  requires true
  ensures true
  effects pure
  example sum_list([]) == 0
  example sum_list([1, 2, 3]) == 6
{ match xs { [] => 0  [h, ..t] => h + sum_list(t) } }

fn length(xs: List[Int]) -> Int
  requires true
  ensures result >= 0
  effects pure
  example length([]) == 0
  example length([1, 2, 3]) == 3
{ match xs { [] => 0  [h, ..t] => 1 + length(t) } }

fn contains(xs: List[Int], x: Int) -> Bool
  requires true
  ensures true
  effects pure
  example contains([], 1) == false
  example contains([1, 2, 3], 2) == true
{ match xs { [] => false  [h, ..t] => h == x or contains(t, x) } }

fn reverse_list(xs: List[Int]) -> List[Int]
  requires true
  ensures length(result) == length(xs)
  effects pure
  example reverse_list([]) == []
  example reverse_list([1, 2, 3]) == [3, 2, 1]
{ match xs { [] => []  [h, ..t] => reverse_list(t) ++ [h] } }

fn safe_div(a: Int, b: Int) -> Option[Int]
  requires true
  ensures (b == 0 and result == None) or (b != 0 and result == Some(a / b))
  effects pure
  example safe_div(7, 2) == Some(3)
  example safe_div(1, 0) == None
{ if b == 0 then None else Some(a / b) }

fn gcd(a: Int, b: Int) -> Int
  requires a >= 0 and b >= 0
  requires a > 0 or b > 0
  ensures result > 0
  ensures a % result == 0 and b % result == 0
  effects pure
  example gcd(12, 18) == 6
  example gcd(0, 5) == 5
{ if b == 0 then a else gcd(b, a % b) }

fn clamp(x: Int, lo: Int, hi: Int) -> Int
  requires lo <= hi
  ensures result >= lo and result <= hi
  effects pure
  example clamp(5, 0, 10) == 5
  example clamp(-5, 0, 10) == 0
  example clamp(15, 0, 10) == 10
{ if x < lo then lo else if x > hi then hi else x }
