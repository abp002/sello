  "python": "def safe_div(a: int, b: int) -> int | None",
  "cases": [
    {
      "args": [
        7,
        2
      ],
      "expect": {
        "some": 3
      }
    },
    {
      "args": [
        1,
        0
      ],
      "expect": null
    },
    {
      "args": [
        -7,
        2
      ],
      "expect": {
        "some": -4
      }
